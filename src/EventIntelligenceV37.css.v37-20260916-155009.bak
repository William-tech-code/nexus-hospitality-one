.ei37-shell{
 margin-top:24px;
 padding:28px;
 border-radius:26px;
 border:1px solid rgba(202,168,84,.20);
 background:
  radial-gradient(
   circle at top right,
   rgba(202,168,84,.09),
   transparent 32%
  ),
  linear-gradient(
   145deg,
   rgba(18,18,20,.98),
   rgba(7,8,10,.99)
  );
 color:#fff;
}

.ei37-header{
 display:flex;
 align-items:flex-start;
 justify-content:space-between;
 gap:20px;
}

.ei37-header>div>span,
.ei37-title>span,
.ei37-event small,
.ei37-ai-content>span{
 font-size:9px;
 letter-spacing:.17em;
 font-weight:850;
 opacity:.45;
}

.ei37-header h2{
 margin:6px 0 8px;
 font-size:30px;
 letter-spacing:-.04em;
}

.ei37-header p{
 margin:0;
 max-width:650px;
 line-height:1.55;
 opacity:.52;
}

.ei37-live{
 display:flex;
 align-items:center;
 gap:8px;
 padding:9px 12px;
 border-radius:99px;
 border:1px solid rgba(255,255,255,.09);
 font-size:9px;
 font-weight:800;
 letter-spacing:.12em;
}

.ei37-live i{
 width:8px;
 height:8px;
 border-radius:50%;
 background:#5ee18c;
 box-shadow:0 0 16px rgba(94,225,140,.7);
}

.ei37-event{
 display:flex;
 justify-content:space-between;
 gap:15px;
 margin-top:24px;
 padding:15px 17px;
 border-radius:16px;
 background:rgba(255,255,255,.035);
 border:1px solid rgba(255,255,255,.06);
}

.ei37-event strong{
 display:block;
 margin-top:4px;
}

.ei37-event>span{
 font-size:9px;
 opacity:.4;
}

.ei37-kpis{
 display:grid;
 grid-template-columns:
  repeat(6,minmax(0,1fr));
 gap:9px;
 margin-top:12px;
}

.ei37-kpis article{
 padding:16px;
 border-radius:16px;
 background:rgba(255,255,255,.035);
 border:1px solid rgba(255,255,255,.06);
}

.ei37-kpis span{
 display:block;
 font-size:8px;
 letter-spacing:.11em;
 opacity:.43;
}

.ei37-kpis strong{
 display:block;
 margin:7px 0 3px;
 font-size:22px;
 letter-spacing:-.03em;
}

.ei37-kpis small{
 font-size:8px;
 opacity:.35;
}

.ei37-grid{
 display:grid;
 grid-template-columns:
  repeat(2,minmax(0,1fr));
 gap:12px;
 margin-top:12px;
}

.ei37-panel,
.ei37-lots{
 padding:20px;
 border-radius:19px;
 background:rgba(255,255,255,.027);
 border:1px solid rgba(255,255,255,.06);
}

.ei37-title h3{
 margin:4px 0 0;
}

.ei37-rows{
 display:grid;
 grid-template-columns:
  repeat(2,minmax(0,1fr));
 gap:8px;
 margin-top:17px;
}

.ei37-rows>div{
 padding:11px;
 border-radius:11px;
 background:rgba(0,0,0,.18);
}

.ei37-rows span{
 display:block;
 font-size:9px;
 opacity:.43;
}

.ei37-rows b{
 display:block;
 margin-top:4px;
}

.ei37-finance-main{
 margin-top:20px;
}

.ei37-finance-main>span{
 display:block;
 font-size:8px;
 letter-spacing:.13em;
 opacity:.4;
}

.ei37-finance-main>strong{
 display:block;
 margin:7px 0;
 font-size:34px;
 letter-spacing:-.05em;
}

.ei37-finance-main>small{
 opacity:.4;
}

.ei37-margin,
.ei37-presence-bar,
.ei37-lot-bar{
 height:4px;
 margin-top:16px;
 overflow:hidden;
 border-radius:99px;
 background:rgba(255,255,255,.07);
}

.ei37-margin>span,
.ei37-presence-bar>i,
.ei37-lot-bar>i{
 display:block;
 height:100%;
 border-radius:99px;
 background:#fff;
}

.ei37-presence{
 margin-top:20px;
}

.ei37-presence>strong{
 display:block;
 font-size:42px;
 letter-spacing:-.05em;
}

.ei37-presence>span,
.ei37-presence>small{
 display:block;
 opacity:.43;
}

.ei37-presence>small{
 margin-top:9px;
}

.ei37-lots{
 margin-top:12px;
}

.ei37-lot-grid{
 display:grid;
 grid-template-columns:
  repeat(3,minmax(0,1fr));
 gap:9px;
 margin-top:17px;
}

.ei37-lot-grid article{
 padding:14px;
 border-radius:13px;
 background:rgba(0,0,0,.17);
}

.ei37-lot-grid article>div:first-child{
 display:flex;
 justify-content:space-between;
 gap:10px;
}

.ei37-lot-grid span{
 font-size:10px;
}

.ei37-lot-grid small{
 display:block;
 margin-top:8px;
 font-size:8px;
 opacity:.4;
}

.ei37-ai{
 display:grid;
 grid-template-columns:72px minmax(0,1fr);
 gap:20px;
 margin-top:12px;
 padding:24px;
 border-radius:21px;
 background:
  linear-gradient(
   135deg,
   rgba(202,168,84,.09),
   rgba(255,255,255,.025)
  );
 border:1px solid rgba(202,168,84,.16);
}

.ei37-ai-orb{
 width:64px;
 height:64px;
 display:grid;
 place-items:center;
 border-radius:20px;
 background:#fff;
 color:#090a0c;
 font-size:24px;
 font-weight:950;
 box-shadow:0 16px 45px rgba(0,0,0,.28);
}

.ei37-ai-content h3{
 margin:5px 0;
 font-size:22px;
}

.ei37-ai-content>p{
 margin:0;
 opacity:.45;
}

.ei37-recommendations{
 display:grid;
 gap:8px;
 margin-top:17px;
}

.ei37-recommendation{
 padding:13px 14px;
 border-radius:12px;
 background:rgba(0,0,0,.18);
 border-left:3px solid rgba(255,255,255,.3);
}

.ei37-recommendation.high{
 border-left-color:#ff6868;
}

.ei37-recommendation.medium{
 border-left-color:#ffbd59;
}

.ei37-recommendation.info{
 border-left-color:#5ee18c;
}

.ei37-recommendation span{
 display:block;
 font-size:8px;
 letter-spacing:.11em;
 opacity:.38;
}

.ei37-recommendation strong{
 display:block;
 margin-top:4px;
}

.ei37-recommendation p{
 margin:5px 0 0;
 font-size:11px;
 line-height:1.5;
 opacity:.55;
}

.ei37-footer{
 display:flex;
 justify-content:space-between;
 gap:10px;
 margin-top:17px;
 padding-top:14px;
 border-top:1px solid rgba(255,255,255,.05);
 font-size:8px;
 letter-spacing:.11em;
 opacity:.28;
}

.ei37-loading,
.ei37-error{
 padding:35px;
 text-align:center;
}

.ei37-loading span{
 display:block;
 width:120px;
 height:2px;
 margin:15px auto 0;
 background:#fff;
 animation:ei37pulse 1.2s infinite;
}

.ei37-error span{
 display:block;
 margin-top:7px;
 opacity:.5;
}

@keyframes ei37pulse{
 0%,100%{opacity:.2}
 50%{opacity:1}
}

@media(max-width:1200px){

 .ei37-kpis{
  grid-template-columns:
   repeat(3,minmax(0,1fr));
 }

}

@media(max-width:800px){

 .ei37-header,
 .ei37-event,
 .ei37-footer{
  flex-direction:column;
 }

 .ei37-grid{
  grid-template-columns:1fr;
 }

 .ei37-lot-grid{
  grid-template-columns:1fr;
 }

 .ei37-ai{
  grid-template-columns:1fr;
 }

}

@media(max-width:560px){

 .ei37-shell{
  padding:18px;
 }

 .ei37-kpis{
  grid-template-columns:
   repeat(2,minmax(0,1fr));
 }

 .ei37-rows{
  grid-template-columns:1fr;
 }

}
