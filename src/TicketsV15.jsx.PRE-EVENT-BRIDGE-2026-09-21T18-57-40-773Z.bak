import React,{
  useEffect,
  useMemo,
  useState
} from 'react';

import {api} from './api.js';

const brl=value=>
  Number(value||0).toLocaleString(
    'pt-BR',
    {
      style:'currency',
      currency:'BRL'
    }
  );

const dt=value=>
  value
    ? new Date(value)
        .toLocaleString('pt-BR')
    : '\u2014';

export default function TicketsV15(){

  const [events,setEvents]=useState([]);
  const [event,setEvent]=useState('');
  const [lots,setLots]=useState([]);
  const [tickets,setTickets]=useState([]);

  const [lot,setLot]=useState({
    name:'1\u00ba Lote',
    price:'',
    quantity:'100'
  });

  const [message,setMessage]=useState('');
  const [busy,setBusy]=useState(false);

  /* NEXUS_EVENT_CREATION_BRIDGE_V154 */
  const [eventForm,setEventForm]=useState({
    title:'',
    starts_at:'',
    venue_name:'',
    description:''
  });

  const [payment,setPayment]=useState(null);

  const [asaas,setAsaas]=useState({
    environment:'SANDBOX',
    base_url:'',
    api_key:'',
    webhook_token:''
  });

  async function loadEventData(eventId){

    if(!eventId){
      setLots([]);
      setTickets([]);
      return;
    }

    const [lotRows,ticketRows]=
      await Promise.all([
        api.ticketLots(eventId),
        api.tickets(eventId)
      ]);

    setLots(lotRows);
    setTickets(ticketRows);
  }

  async function load(){

    try{

      const rows=
        await api.ticketEvents();

      setEvents(rows);

      const selected=
        event ||
        rows[0]?.id;

      if(selected){

        setEvent(
          String(selected)
        );

        await loadEventData(
          selected
        );
      }

    }catch(error){

      setMessage(
        error.message
      );
    }
  }

  async function loadPayment(){

    try{

      const response=
        await api.paymentConfigV15();

      setPayment(
        response.asaas
      );

      setAsaas(current=>({
        ...current,

        environment:
          response.asaas?.environment ||
          'SANDBOX',

        base_url:
          response.asaas?.base_url ||
          ''
      }));

    }catch(error){

      setMessage(
        error.message
      );
    }
  }

  useEffect(()=>{

    load();
    loadPayment();

  },[]);

  useEffect(()=>{

    if(!event) return;

    loadEventData(event)
      .catch(error=>
        setMessage(
          error.message
        )
      );

  },[event]);

  const active=
    events.find(
      row=>
        String(row.id)===
        String(event)
    );

  const stats=useMemo(()=>{

    const sold=
      Number(
        active?.tickets ||
        tickets.length ||
        0
      );

    const checked=
      Number(
        active?.checked_in ||
        tickets.filter(
          row=>row.checkin_at
        ).length
      );

    const revenue=
      Number(
        active?.revenue ||
        tickets.reduce(
          (sum,row)=>
            sum+
            (
              row.payment_status==='PAID'
                ? Number(row.price||0)
                : 0
            ),
          0
        )
      );

    const attendance=
      sold>0
        ? Math.round(
            checked/sold*100
          )
        : 0;

    return {
      sold,
      checked,
      revenue,
      attendance
    };

  },[
    active,
    tickets
  ]);

  async function createAndPublishEvent(){

    try{

      setBusy(true);
      setMessage('');

      const title=
        String(eventForm.title||'').trim();

      if(!title){
        throw new Error(
          'Informe o nome do evento.'
        );
      }

      if(!eventForm.starts_at){
        throw new Error(
          'Informe a data e o horario do evento.'
        );
      }

      /*
       * Cria usando o motor de eventos
       * já existente no NEXUS.
       */
      const created=
        await api.createEventV06({
          title,
          starts_at:eventForm.starts_at,
          venue_name:
            String(
              eventForm.venue_name||''
            ).trim()||null,
          description:
            String(
              eventForm.description||''
            ).trim()||null
        });

      const createdId=
        created?.id||
        created?.event?.id;

      if(!createdId){
        throw new Error(
          'Evento criado sem identificador.'
        );
      }

      /*
       * Publica para a Event Experience.
       */
      await api.updateEventV12(
        createdId,
        {
          public_sales:true,
          status:'ACTIVE',
          description:
            String(
              eventForm.description||''
            ).trim()||null
        }
      );

      setEventForm({
        title:'',
        starts_at:'',
        venue_name:'',
        description:''
      });

      /*
       * Atualiza a lista e seleciona
       * automaticamente o novo evento.
       */
      const rows=
        await api.ticketEvents();

      setEvents(rows);

      setEvent(
        String(createdId)
      );

      await loadEventData(
        createdId
      );

      setMessage(
        'Evento criado e publicado com sucesso. Agora crie o lote.'
      );

    }catch(error){

      console.error(
        'NEXUS_EVENT_CREATE',
        error
      );

      setMessage(
        error?.message||
        'Nao foi possivel criar o evento.'
      );

    }finally{

      setBusy(false);
    }
  }


  async function publishCurrentEvent(){

    if(!event){
      setMessage(
        'Selecione um evento.'
      );
      return;
    }

    try{

      setBusy(true);
      setMessage('');

      await api.updateEventV12(
        event,
        {
          public_sales:true,
          status:'ACTIVE'
        }
      );

      await load();

      setMessage(
        'Evento publicado. A pagina publica esta liberada.'
      );

    }catch(error){

      console.error(
        'NEXUS_EVENT_PUBLISH',
        error
      );

      setMessage(
        error?.message||
        'Nao foi possivel publicar o evento.'
      );

    }finally{

      setBusy(false);
    }
  }


  async function addLot(){

    try{

      setBusy(true);
      setMessage('');

      await api.createTicketLot({
        ...lot,

        event_id:
          Number(event),

        price:
          Number(
            String(lot.price)
              .replace(',','.')
          ),

        quantity:
          Number(lot.quantity)
      });

      setLots(
        await api.ticketLots(event)
      );

      setMessage(
        'Lote criado com sucesso.'
      );

    }catch(error){

      setMessage(
        error.message
      );

    }finally{

      setBusy(false);
    }
  }

  async function saveAsaas(){

    try{

      setBusy(true);
      setMessage('');

      if(
        !asaas.api_key.trim() &&
        !payment?.configured
      ){
        throw new Error(
          'Informe a API Key do Asaas.'
        );
      }

      if(
        !asaas.webhook_token.trim() &&
        !payment?.webhook_configured
      ){
        throw new Error(
          'Informe o token do webhook.'
        );
      }

      const body={
        environment:
          String(
            asaas.environment
          ).toLowerCase(),

        base_url:
          asaas.base_url
      };

      if(
        asaas.api_key.trim()
      ){
        body.api_key=
          asaas.api_key.trim();
      }

      if(
        asaas.webhook_token.trim()
      ){
        body.webhook_token=
          asaas.webhook_token.trim();
      }

      const response=
        await api.saveAsaasV15(
          body
        );

      setPayment(
        response.asaas
      );

      setAsaas(current=>({
        ...current,
        api_key:'',
        webhook_token:'',
        environment:
          response.asaas.environment,
        base_url:
          response.asaas.base_url
      }));

      setMessage(
        'Configuracao Asaas salva com seguranca.'
      );

    }catch(error){

      setMessage(
        error.message
      );

    }finally{

      setBusy(false);
    }
  }

  async function testAsaas(){

    try{

      setBusy(true);
      setMessage('');

      const response=
        await api.testAsaasV15();

      setMessage(
        `Asaas conectado - ${response.environment} - ${response.account_status}`
      );

      await loadPayment();

    }catch(error){

      setMessage(
        `Falha na conexao Asaas: ${error.message}`
      );

    }finally{

      setBusy(false);
    }
  }

  const publicUrl=
    event
      ? `${location.origin}/eventos/${event}`
      : `${location.origin}/eventos`;

  const webhookUrl=
    `${location.origin}/api/webhooks/asaas`;

  return (
    <section className="ticket15">

      <header>

        <div>

          <span>
            NEXUS TICKETS {'\u2022'} PAYMENT INTELLIGENCE
          </span>

          <h1>
            Ingressos & Acesso
          </h1>

          <p>
            Venda, pagamento, QR Code e controle de acesso em uma unica operacao.
          </p>

        </div>

        <button
          disabled={!event}
          onClick={()=>
            window.open(
              `/eventos/${event}`,
              '_blank'
            )
          }
        >
          ABRIR PAGINA DE VENDA
        </button>

      </header>

      {message&&
        <div className="ticket15-msg">
          {message}
        </div>
      }

      <div className="ticket15-kpis">

        <div>
          <small>VENDIDOS</small>
          <b>{stats.sold}</b>
        </div>

        <div>
          <small>CHECK-INS</small>
          <b>{stats.checked}</b>
        </div>

        <div>
          <small>RECEITA</small>
          <b>{brl(stats.revenue)}</b>
        </div>

        <div>
          <small>PRESENCA</small>
          <b>{stats.attendance}%</b>
        </div>

      </div>

      <main>

        <section className="ticket15-config">

          <div className="ticket15-title">

            <span>EVENTO</span>

            <h2>
              Evento e lotes
            </h2>

          </div>

          <div
            style={{
              display:'grid',
              gap:10,
              marginBottom:18,
              padding:16,
              border:'1px solid rgba(255,255,255,.10)',
              borderRadius:16
            }}
          >

            <div className="ticket15-title">

              <span>
                NOVO EVENTO
              </span>

              <h2>
                Criar e publicar evento
              </h2>

            </div>

            <input
              value={eventForm.title}
              onChange={e=>
                setEventForm({
                  ...eventForm,
                  title:e.target.value
                })
              }
              placeholder="Nome do evento"
            />

            <input
              type="datetime-local"
              value={eventForm.starts_at}
              onChange={e=>
                setEventForm({
                  ...eventForm,
                  starts_at:e.target.value
                })
              }
            />

            <input
              value={eventForm.venue_name}
              onChange={e=>
                setEventForm({
                  ...eventForm,
                  venue_name:e.target.value
                })
              }
              placeholder="Local do evento"
            />

            <textarea
              value={eventForm.description}
              onChange={e=>
                setEventForm({
                  ...eventForm,
                  description:e.target.value
                })
              }
              placeholder="Descricao do evento"
              rows="3"
            />

            <button
              className="primary"
              disabled={busy}
              onClick={createAndPublishEvent}
            >
              {busy
                ?'PROCESSANDO...'
                :'CRIAR E PUBLICAR EVENTO'}
            </button>

          </div>


          <label>

            EVENTO

            <select
              value={event}
              onChange={
                e=>setEvent(
                  e.target.value
                )
              }
            >

              {events.map(row=>
                <option
                  key={row.id}
                  value={row.id}
                >
                  {row.title} {'\u2022'} {dt(row.starts_at)}
                </option>
              )}

            </select>

          </label>

          {!events.length&&
            <div className="ticket15-empty">
              Nenhum evento cadastrado. Use o formulario acima para criar o primeiro.
            </div>
          }

          {!!event&&
            <div
              style={{
                display:'flex',
                gap:10,
                flexWrap:'wrap',
                margin:'12px 0 18px'
              }}
            >

              <button
                disabled={busy}
                onClick={publishCurrentEvent}
              >
                PUBLICAR / LIBERAR VENDA
              </button>

              <button
                disabled={!event}
                onClick={()=>
                  window.open(
                    `/eventos/${event}`,
                    '_blank',
                    'noopener,noreferrer'
                  )
                }
              >
                ABRIR EXPERIENCIA PUBLICA
              </button>

            </div>
          }

          <div className="ticket15-lotform">

            <input
              value={lot.name}
              onChange={
                e=>setLot({
                  ...lot,
                  name:e.target.value
                })
              }
              placeholder="Nome do lote"
            />

            <input
              value={lot.price}
              onChange={
                e=>setLot({
                  ...lot,
                  price:e.target.value
                })
              }
              placeholder="Preco R$"
            />

            <input
              type="number"
              value={lot.quantity}
              onChange={
                e=>setLot({
                  ...lot,
                  quantity:e.target.value
                })
              }
              placeholder="Quantidade"
            />

            <button
              disabled={
                !event ||
                busy
              }
              onClick={addLot}
            >
              CRIAR LOTE
            </button>

          </div>

          <div className="ticket15-lots">

            {lots.map(row=>
              <div key={row.id}>

                <span>

                  <b>
                    {row.name}
                  </b>

                  <small>
                    {row.sold}/{row.quantity} vendidos
                  </small>

                </span>

                <strong>
                  {brl(row.price)}
                </strong>

                <em>
                  {Math.max(
                    0,
                    Number(row.quantity)-
                    Number(row.sold)
                  )} disponiveis
                </em>

              </div>
            )}

          </div>

          <div className="ticket15-link">

            <small>
              LINK PARA DIVULGACAO
            </small>

            <code>
              {publicUrl}
            </code>

            <button
              onClick={()=>
                navigator.clipboard
                  ?.writeText(
                    publicUrl
                  )
              }
            >
              COPIAR LINK
            </button>

          </div>

        </section>

        <section className="ticket15-how">

          <span>
            AUTOMACAO DO INGRESSO
          </span>

          <h2>
            Da compra a portaria
          </h2>

          {[
            ['01','Cliente abre o link'],
            ['02','Escolhe evento e lote'],
            ['03','Preenche seus dados'],
            ['04','Asaas processa o pagamento'],
            ['05','Webhook confirma o recebimento'],
            ['06','NEXUS gera QR Code unico'],
            ['07','Portaria valida uma unica vez']
          ].map(row=>
            <div key={row[0]}>
              <b>{row[0]}</b>
              <span>{row[1]}</span>
            </div>
          )}

        </section>

      </main>

      <section
        className="ticket15-config"
        data-nexus-payment-center="asaas"
      >

        <div className="ticket15-title">

          <span>
            NEXUS PAYMENTS
          </span>

          <h2>
            Configuracao Asaas
          </h2>

        </div>

        <div className="ticket15-kpis">

          <div>

            <small>
              AMBIENTE
            </small>

            <b>
              {payment?.environment||'\u2014'}
            </b>

          </div>

          <div>

            <small>
              API
            </small>

            <b>
              {payment?.configured
                ? 'CONFIGURADA'
                : 'PENDENTE'}
            </b>

          </div>

          <div>

            <small>
              WEBHOOK
            </small>

            <b>
              {payment?.webhook_configured
                ? 'CONFIGURADO'
                : 'PENDENTE'}
            </b>

          </div>

          <div>

            <small>
              PROTECAO
            </small>

            <b>
              {payment?.secure_storage||
               'WINDOWS DPAPI'}
            </b>

          </div>

        </div>

        <div className="ticket15-lotform">

          <select
            value={asaas.environment}
            onChange={
              e=>setAsaas({
                ...asaas,

                environment:
                  e.target.value,

                base_url:
                  e.target.value==='PRODUCTION'
                    ? 'https://api.asaas.com/v3'
                    : 'https://api-sandbox.asaas.com/v3'
              })
            }
          >

            <option value="SANDBOX">
              SANDBOX
            </option>

            <option value="PRODUCTION">
              PRODUCAO
            </option>

          </select>

          <input
            value={asaas.base_url}
            onChange={
              e=>setAsaas({
                ...asaas,
                base_url:e.target.value
              })
            }
            placeholder="Base URL Asaas"
          />

          <input
            type="password"
            autoComplete="new-password"
            value={asaas.api_key}
            onChange={
              e=>setAsaas({
                ...asaas,
                api_key:e.target.value
              })
            }
            placeholder={
              payment?.configured
                ? `API Key atual ${payment.api_key_masked||''}`
                : 'API Key Asaas'
            }
          />

          <input
            type="password"
            autoComplete="new-password"
            value={asaas.webhook_token}
            onChange={
              e=>setAsaas({
                ...asaas,
                webhook_token:e.target.value
              })
            }
            placeholder={
              payment?.webhook_configured
                ? `Webhook atual ${payment.webhook_token_masked||''}`
                : 'Token do webhook'
            }
          />

        </div>

        <div className="ticket15-link">

          <small>
            ENDERECO DO WEBHOOK
          </small>

          <code>
            {webhookUrl}
          </code>

          <button
            onClick={()=>
              navigator.clipboard
                ?.writeText(
                  webhookUrl
                )
            }
          >
            COPIAR
          </button>

        </div>

        <div
          style={{
            display:'flex',
            gap:10,
            flexWrap:'wrap',
            marginTop:14
          }}
        >

          <button
            className="primary"
            disabled={busy}
            onClick={saveAsaas}
          >
            {busy
              ? 'PROCESSANDO...'
              : 'SALVAR CONFIGURACAO'}
          </button>

          <button
            disabled={
              busy ||
              !payment?.configured
            }
            onClick={testAsaas}
          >
            TESTAR CONEXAO
          </button>

        </div>

        <p
          style={{
            opacity:.72,
            marginTop:12
          }}
        >
          A API Key e o token do webhook sao protegidos pelo Windows DPAPI.
          O NEXUS nao exibe os segredos completos depois de salvos.
        </p>

      </section>

      <section className="ticket15-table">

        <div className="ticket15-title">

          <span>
            INGRESSOS EMITIDOS
          </span>

          <h2>
            Compradores & acesso
          </h2>

        </div>

        <div className="table-wrap">

          <table>

            <thead>

              <tr>
                <th>Codigo</th>
                <th>Participante</th>
                <th>Lote</th>
                <th>Valor</th>
                <th>Pagamento</th>
                <th>Acesso</th>
              </tr>

            </thead>

            <tbody>

              {tickets.map(row=>
                <tr key={row.id}>

                  <td>
                    <b>
                      {row.ticket_code}
                    </b>
                  </td>

                  <td>
                    {row.attendee_name}

                    <small>
                      {row.attendee_phone}
                    </small>
                  </td>

                  <td>
                    {row.lot_name||
                     row.ticket_type}
                  </td>

                  <td>
                    {brl(row.price)}
                  </td>

                  <td>
                    {row.payment_status}
                  </td>

                  <td>
                    {row.checkin_at
                      ? `OK ${dt(row.checkin_at)}`
                      : 'AGUARDANDO'}
                  </td>

                </tr>
              )}

            </tbody>

          </table>

        </div>

      </section>

    </section>
  );
}
