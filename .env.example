# NEXUS Hospitality One V1.2 — Asaas
# Configure estas variáveis no Railway. NÃO salve a chave real no Git.
ASAAS_API_KEY=
ASAAS_BASE_URL=https://api.asaas.com/v3
ASAAS_WEBHOOK_TOKEN=

# ============================================================
# NEXUS EVENT EXPERIENCE V3.9 - TICKET DELIVERY
# Never commit real secrets.
# ============================================================

# Public HTTPS URL where customers access NEXUS.
# Example:
# NEXUS_PUBLIC_URL=https://eventos.seudominio.com.br
NEXUS_PUBLIC_URL=

# EMAIL - RESEND
RESEND_API_KEY=
# Example:
# NEXUS_EMAIL_FROM=NEXUS Eventos <ingressos@seudominio.com.br>
NEXUS_EMAIL_FROM=

# WHATSAPP CLOUD API - META
META_WHATSAPP_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=

NODE_ENV=production
NEXUS_DATA_DIR=/data
