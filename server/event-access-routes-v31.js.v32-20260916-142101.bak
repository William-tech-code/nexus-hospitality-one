import crypto from "crypto";
import { db } from "./db.js";
import {
  resolveWalletMagicLink
} from "./event-access-v31.js";

function hash(value){
  return crypto
    .createHash("sha256")
    .update(String(value))
    .digest("hex");
}

export function registerEventAccessV31(app){

  app.post(
    "/api/public/event-experience/access",
    (req,res)=>{

      try{

        const raw=String(
          req.body?.token||""
        ).trim();

        if(!raw){
          return res.status(400).json({
            error:"ACCESS_TOKEN_REQUIRED"
          });
        }

        const link=
          resolveWalletMagicLink(raw);

        if(!link){
          return res.status(401).json({
            error:"ACCESS_LINK_INVALID_OR_EXPIRED"
          });
        }

        const sessionToken=
          crypto
            .randomBytes(32)
            .toString("hex");

        const sessionHash=
          hash(sessionToken);

        db.prepare(`
          INSERT INTO ticket_customer_sessions(
            ticket_customer_id,
            session_hash,
            status,
            expires_at
          )
          VALUES(
            ?,
            ?,
            'ACTIVE',
            datetime('now','+30 days')
          )
        `).run(
          link.ticket_customer_id,
          sessionHash
        );

        db.prepare(`
          UPDATE ticket_magic_links
          SET used_at=CURRENT_TIMESTAMP
          WHERE id=?
        `).run(link.id);

        res.json({
          ok:true,
          session:sessionToken,
          customer_id:
            link.ticket_customer_id,
          order_id:
            link.ticket_order_id,
          redirect:
            "/meus-ingressos"
        });

      }catch(error){

        console.error(
          "[EVENT_ACCESS_V31]",
          error?.message||error
        );

        res.status(500).json({
          error:"EVENT_ACCESS_FAILED"
        });
      }
    }
  );

  console.log(
    "NEXUS EVENT EXPERIENCE V3.1 ROUTES ONLINE"
  );
}
